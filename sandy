* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f0f8ff;
    color: #333;
}

/* Header */
header {
    background-color: #063970;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 12px;
    font-weight: bold;
}

nav a:hover {
    color: yellow;
}

/* Hero */
.hero {
    background: linear-gradient(120deg, #0077b6, #48cae4);
    color: white;
    text-align: center;
    padding: 70px 20px;
}

.hero h2 {
    font-size: 35px;
    margin-bottom: 15px;
}

/* Booking Form */
.booking {
    background: white;
    width: 85%;
    max-width: 600px;
    margin: 30px auto;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #aaa;
}

.booking h2 {
    text-align: center;
    color: #063970;
    margin-bottom: 20px;
}

label {
    display: block;
    margin-top: 12px;
    font-weight: bold;
}

input, select {
    width: 100%;
    padding: 12px;
    margin-top: 6px;
    border: 1px solid #aaa;
    border-radius: 6px;
}

button {
    width: 100%;
    padding: 13px;
    margin-top: 20px;
    background-color: #0077b6;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 17px;
    cursor: pointer;
}

button:hover {
    background-color: #023e8a;
}

/* Services */
.services, .fare, .seats {
    padding: 35px 20px;
    text-align: center;
}

.services h2, .fare h2, .seats h2 {
    color: #063970;
    margin-bottom: 25px;
}

.cards {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.card {
    background: white;
    width: 250px;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 10px #bbb;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    background-color: #caf0f8;
}

.card h3 {
    margin: 10px;
    color: #0077b6;
}

/* Fare Table */
table {
    width: 90%;
    margin: auto;
    border-collapse: collapse;
    background: white;
}

th, td {
    border: 1px solid #aaa;
    padding: 14px;
    text-align: center;
}

th {
    background-color: #063970;
    color: white;
}

tr:nth-child(even) {
    background-color: #dff6ff;
}

/* Seat Selection */
.seat-layout {
    display: grid;
    grid-template-columns: repeat(5, 55px);
    gap: 12px;
    justify-content: center;
    margin: 25px;
}

.seat {
    background-color: #52b788;
    color: white;
    padding: 15px;
    border-radius: 7px;
    cursor: pointer;
}

.seat:hover {
    background-color: #087f5b;
}

.booked {
    background-color: #e63946;
    cursor: not-allowed;
}

.empty {
    width: 55px;
}

/* Footer */
footer {
    background-color: #063970;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

footer p {
    margin: 8px;
}

/* Responsive Design */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        display: inline-block;
        margin: 6px;
    }

    .hero h2 {
        font-size: 25px;
    }

    .booking {
        width: 95%;
    }

    table {
        width: 100%;
        font-size: 12px;
    }

    th, td {
        padding: 8px 4px;
    }
}
