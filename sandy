
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Booking Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header>
        <h1>🌍 TravelGo</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#booking">Booking</a>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Welcome Section -->
    <section class="hero" id="home">
        <h2>Explore The World With TravelGo</h2>
        <p>Book your journey easily, safely and comfortably!</p>
    </section>

    <!-- Booking Form -->
    <section class="booking" id="booking">
        <h2>✈ Book Your Journey</h2>

        <form>
            <label>Source City:</label>
            <input type="text" placeholder="Enter source city" required>

            <label>Destination City:</label>
            <input type="text" placeholder="Enter destination city" required>

            <label>Travel Date:</label>
            <input type="date" required>

            <label>Return Date:</label>
            <input type="date">

            <label>Number of Passengers:</label>
            <input type="number" min="1" max="10" value="1">

            <label>Passenger Name:</label>
            <input type="text" placeholder="Enter passenger name">

            <label>Travel Type:</label>
            <select>
                <option>Bus</option>
                <option>Train</option>
                <option>Flight</option>
            </select>

            <button type="submit">Search Tickets</button>
        </form>
    </section>

    <!-- Available Services -->
    <section class="services" id="services">
        <h2>Our Travel Services</h2>

        <div class="cards">
            <div class="card">
                <h3>🚌 Bus Booking</h3>
                <p>Comfortable bus journeys.</p>
                <h3>₹800</h3>
            </div>

            <div class="card">
                <h3>🚆 Train Booking</h3>
                <p>Affordable train tickets.</p>
                <h3>₹600</h3>
            </div>

            <div class="card">
                <h3>✈ Flight Booking</h3>
                <p>Fast and comfortable flights.</p>
                <h3>₹3,500</h3>
            </div>
        </div>
    </section>

    <!-- Fare Table -->
    <section class="fare">
        <h2>Ticket Fare Information</h2>

        <table>
            <tr>
                <th>Travel Type</th>
                <th>Departure</th>
                <th>Arrival</th>
                <th>Fare</th>
            </tr>

            <tr>
                <td>Bus</td>
                <td>Vijayawada</td>
                <td>Hyderabad</td>
                <td>₹800</td>
            </tr>

            <tr>
                <td>Train</td>
                <td>Vijayawada</td>
                <td>Chennai</td>
                <td>₹600</td>
            </tr>

            <tr>
                <td>Flight</td>
                <td>Hyderabad</td>
                <td>Delhi</td>
                <td>₹3,500</td>
            </tr>
        </table>
    </section>

    <!-- Seat Selection -->
    <section class="seats">
        <h2>Select Your Seat</h2>
        <p>Choose your preferred seat below.</p>

        <div class="seat-layout">
            <div class="seat">1</div>
            <div class="seat">2</div>
            <div class="empty"></div>
            <div class="seat">3</div>
            <div class="seat">4</div>

            <div class="seat">5</div>
            <div class="seat">6</div>
            <div class="empty"></div>
            <div class="seat booked">7</div>
            <div class="seat">8</div>

            <div class="seat">9</div>
            <div class="seat">10</div>
            <div class="empty"></div>
            <div class="seat">11</div>
            <div class="seat">12</div>
        </div>

        <p>
            🟩 Available
            🟥 Booked
        </p>
    </section>

    <!-- Contact -->
    <footer id="contact">
        <h2>TravelGo</h2>
        <p>Email: travelgo@gmail.com</p>
        <p>Phone: +91 9876543210</p>
        <p>© 2026 TravelGo. All Rights Reserved.</p>
    </footer>

</body>
</html>

